{
  "AllowedHosts": "localhost",
  "Trading": {
    "Mode": "Paper"
  },
  "ConnectionStrings": {
    "TradingDatabase": ""
  },
  "IdentityBootstrap": {
    "Enabled": false,
    "Username": "",
    "Email": "",
    "Password": ""
  },
  "DatabaseInitialization": {
    "ApplyMigrations": false
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Groww": {
    "ApiBaseUrl": "https://api.groww.in/",
    "InstrumentMasterUrl": "https://growwapi-assets.groww.in/instruments/instrument.csv",
    "AccessTokenEnvironmentVariable": "GROWW_ACCESS_TOKEN",
    "TimeoutSeconds": 15,
    "MaximumInstrumentBytes": 67108864
  },
  "MarketData": {
    "MaximumAgeSeconds": 5,
    "CandleIntervalSeconds": 60,
    "LiveNifty": {
      "Enabled": false,
      "Exchange": "NSE",
      "Segment": "CASH",
      "TradingSymbol": "NIFTY",
      "PollIntervalSeconds": 2,
      "WorkspaceCandleCount": 1500
    }
  },
  "MarketRegime": {
    "MinimumDataQuality": 0.90,
    "MinimumTradingConfidence": 0.50,
    "GapThresholdPercent": 0.40,
    "StrongTrendEmaSpreadPercent": 0.25,
    "WeakTrendEmaSpreadPercent": 0.08,
    "HighAtrPercent": 0.80,
    "LowAtrPercent": 0.25,
    "ExpansionRelativeVolume": 1.50
  },
  "Strategies": {
    "OpeningRangeBreakout": {
      "BreakoutBufferPercent": 0.05,
      "MinimumRelativeVolume": 0.75,
      "MinimumRegimeConfidence": 0.50,
      "RewardToRiskRatio": 2.0,
      "SignalExpirySeconds": 30,
      "CooldownMinutes": 30,
      "MaximumTradesPerDay": 3,
      "EnforceDailyTradeLimit": false
    },
    "PriceAction": {
      "MinimumScore": 0.55,
      "RewardToRiskRatio": 2.0,
      "SignalExpirySeconds": 30,
      "CooldownMinutes": 20,
      "MaximumTradesPerStrategyPerDay": 2,
      "MaximumTradesPerDay": 3,
      "EnforceDailyTradeLimits": false
    }
  },
  "Risk": {
    "Preliminary": {
      "MaximumRiskPerTrade": 5000,
      "MaximumQuantity": 1000,
      "MaximumCapitalExposure": 200000,
      "MinimumRewardToRiskRatio": 1.8,
      "MaximumTradesPerDay": 3,
      "MaximumOpenPositions": 8,
      "EnforceDailyTradeLimit": false
    }
  },
  "PaperTrading": {
    "Automation": {
      "Enabled": false,
      "EvaluationIntervalSeconds": 5,
      "NoTradeAuditIntervalMinutes": 15,
      "EntryWindowStart": "09:15",
      "OpeningRangeEnd": "09:30",
      "EntryCutoff": "15:15",
      "ForcedExit": "15:15",
      "MaximumDailyLoss": 5000,
      "MaximumEntrySlippagePercent": 0.10,
      "MaximumOptionSpreadPercent": 1.5,
      "MaximumOptionPremium": 500,
      "MinimumOptionVolume": 100,
      "MinimumOptionOpenInterest": 100,
      "OptionStopLossPercent": 10,
      "OptionRewardToRiskRatio": 1.0,
      "MaximumOptionLots": 5,
      "MaximumOptionDaysToExpiry": 10,
      "ExpiryDayInTheMoneySteps": 1,
      "NormalInTheMoneySteps": 0,
      "OptionStrikeStep": 50,
      "PermissivePaperExecution": true,
      "BreakEvenEnabled": true,
      "BreakEvenTriggerRiskMultiple": 1.0,
      "TrailingStopEnabled": true,
      "TrailingStopRiskMultiple": 1.0,
      "ProfitLockTriggerRiskMultiple": 0.90,
      "ProfitLockRiskMultiple": 0.80,
      "PartialProfitEnabled": true,
      "PartialProfitRiskMultiple": 1.0,
      "PartialExitFraction": 0.40,
      "UnderlyingTrendInvalidationEnabled": true,
      "MinimumReversalStructureStrength": 0.55,
      "RequiredReversalEvidenceCount": 3,
      "ProtectProfitableConfirmedReversals": true,
      "ReversalProfitLockFraction": 0.80,
      "ExitResearchMaximumDelayMinutes": 3,
      "MinimumSignalCandles": 4,
      "MinimumFuturesConfirmationCandles": 2,
      "PositionRecoveryLookbackDays": 14,
      "MaximumConcurrentPositions": 8,
      "SelectiveHedgingEnabled": true,
      "HedgeMinimumAtrPercent": 0.35,
      "HedgeMinimumRelativeFuturesVolume": 1.0,
      "HedgeMinimumSignalConfidence": 0.60,
      "WeeklyCarryForwardEnabled": false,
      "WeeklyCarryMaximumDaysToExpiry": 7,
      "WeeklyCarryMinimumConfidence": 0.65
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
